{
  "name": "rz-minetrix-quarry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate": "node ./scripts/migrate-postgres.js",
    "migrate:dev": "node ./scripts/migrate-postgres.js",
    "db:seed": "node ./scripts/migrate-postgres.js && node ./scripts/migrate-json-to-pg.js",
    "test": "node --import tsx --test tests/*.test.ts"
    "test": "node --test --experimental-strip-types ./tests/**/*.test.ts",
    "docker:build": "docker build -t rz-minetrix-erp .",
    "migrate:json-to-pg": "node --import tsx scripts/migrate-json-to-pg.ts"
  },
  "dependencies": {
