    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase-admin": "^13.2.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "pg": "^8.11.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-kit": "^0.31.11",
    "firebase": "^12.5.0",
