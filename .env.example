# Existing AI features
GEMINI_API_KEY=

# PostgreSQL (required for production ERP persistence)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_ADAPTER=postgres

# Local-only fallback: set DB_ADAPTER=local-json explicitly in development.
# Never use local-json in production. Run `npm run migrate` before `npm run db:seed`.

# Firebase Admin SDK (required for API authentication)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: set to the Firebase UID of the first owner only during controlled bootstrap.
# Remove this value after the owner account is provisioned.
BOOTSTRAP_OWNER_UID=

# Destructive operations are disabled by default.
ENABLE_RESET=false
NODE_ENV=development
PORT=3000
GEMINI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rz_minetrix
