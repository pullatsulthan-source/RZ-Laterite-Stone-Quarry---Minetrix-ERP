# AI features
GEMINI_API_KEY=

# PostgreSQL (required for production ERP persistence)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_ADAPTER=postgres

# Firebase Admin SDK (server-side token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Exactly two unique Google account emails, comma-separated.
# Both accounts must have verified Firebase email claims. Unset/invalid values deny all access.
ALLOWED_USER_EMAILS=first-authorized@example.com,second-authorized@example.com

# Optional controlled role bootstrap by Firebase UID.
# Use the verified UID for the account that should receive each role.
# Do not set both variables to the same UID. If unset, non-owner accounts default to VIEWER.
BOOTSTRAP_OWNER_UID=
BOOTSTRAP_ADMIN_UID=

# Destructive operations are disabled by default.
ENABLE_RESET=false
ENABLE_IMPORT=false
NODE_ENV=development
PORT=3000

# Frontend Firebase Web SDK configuration (public Firebase project values; not Admin secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
